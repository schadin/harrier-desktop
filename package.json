{
  "name": "harrier-desktop",
  "version": "4.12.6-harrier.8-beta",
  "description": "Matrix desktop client powered by Cinny",
  "main": "index.js",
  "engines": {
    "node": ">=16.0.0"
  },
  "scripts": {
    "tauri": "shx cp config.json cinny/ && node scripts/tauri.mjs",
    "bump": "node scripts/update-version.mjs",
    "rebrand:apply": "node scripts/rebrand.mjs apply",
    "rebrand:revert": "node scripts/rebrand.mjs revert",
    "install-bin": "test -f src-tauri/target/release/harrier || npm run tauri build -- --no-bundle && sudo install -m 755 src-tauri/target/release/harrier /usr/bin/harrier"
  },
  "keywords": [],
  "author": "Ajay Bura",
  "license": "AGPL-3.0-only",
  "dependencies": {
    "@tauri-apps/api": "2.7.0",
    "@tauri-apps/plugin-clipboard-manager": "2.3.0",
    "@tauri-apps/plugin-dialog": "2.3.2",
    "@tauri-apps/plugin-fs": "2.4.1",
    "@tauri-apps/plugin-global-shortcut": "2.3.0",
    "@tauri-apps/plugin-http": "2.5.1",
    "@tauri-apps/plugin-notification": "2.3.0",
    "@tauri-apps/plugin-os": "2.3.0",
    "@tauri-apps/plugin-process": "2.3.0",
    "@tauri-apps/plugin-shell": "2.3.0"
  },
  "devDependencies": {
    "@actions/github": "9.1.1",
    "@tauri-apps/cli": "2.7.1",
    "shx": "0.4.0"
  }
}
